{
  "$template": "网申简历自动填充 · 档案导入模板",
  "$usage": [
    "把这份模板和你自己的简历（PDF / 截图 / 一段文字都行）一起发给任意大模型，然后说：「请阅读我的简历，按这份 JSON 模板的结构输出一份填好的 JSON，保留全部字段名，只输出 JSON 本身」。",
    "把模型给出的 JSON 存成文件，回到扩展的「编辑档案」页点「导入 JSON」。",
    "以 $ 开头的键只是给你和模型看的说明，导入时会被自动忽略，不用手工删。"
  ],
  "$rules": [
    "只填简历里写到的内容。没有的信息留空字符串（\"\"）或空数组（[]），不要编造、不要猜测。",
    "日期：年月只写 YYYY-MM（2026-06），完整日期写 YYYY-MM-DD。",
    "标了 enum 的字段只能填给出的候选值之一（例：学历填「本科」，不要填「本科（学士）」）。确实没有合适的就留空。",
    "教育经历 / 实习经历 / 项目经历 / 校园经历 是数组：每个对象是一段，按时间倒序，最近的一段排在第一个。没有这类经历就留成 []。",
    "证件号码（身份证号）要能通过 18 位校验，填错会被扩展拦下来不填。",
    "文件类字段（简历文件、证件照、成绩单）这一版不会自动上传，填了也只会被忽略。"
  ],
  "$fields": {
    "basic.nameCn": {
      "label": "姓名",
      "type": "text",
      "required": true,
      "example": "张三"
    },
    "basic.nameEn": {
      "label": "英文名",
      "type": "text",
      "example": "San Zhang"
    },
    "basic.namePinyin": {
      "label": "姓名拼音",
      "type": "text",
      "example": "ZHANG SAN"
    },
    "basic.usedName": {
      "label": "曾用名",
      "type": "text",
      "note": "无则填「无」"
    },
    "basic.gender": {
      "label": "性别",
      "type": "enum",
      "required": true,
      "enum": [
        "男",
        "女"
      ]
    },
    "basic.birthDate": {
      "label": "出生日期",
      "type": "dateYm",
      "required": true,
      "example": "2003-05"
    },
    "basic.age": {
      "label": "年龄",
      "type": "number",
      "note": "多数系统按出生日期自动计算，可留空"
    },
    "basic.nationality": {
      "label": "国籍",
      "type": "enum",
      "enum": [
        "中国",
        "中国香港",
        "中国澳门",
        "中国台湾",
        "其他"
      ]
    },
    "basic.ethnicity": {
      "label": "民族",
      "type": "enum",
      "enum": [
        "汉族",
        "回族",
        "满族",
        "蒙古族",
        "壮族",
        "维吾尔族",
        "其他"
      ]
    },
    "basic.politicalStatus": {
      "label": "政治面貌",
      "type": "enum",
      "enum": [
        "中共党员",
        "中共预备党员",
        "共青团员",
        "民主党派",
        "群众"
      ]
    },
    "basic.maritalStatus": {
      "label": "婚姻状况",
      "type": "enum",
      "enum": [
        "未婚",
        "已婚",
        "离异"
      ]
    },
    "basic.hometown": {
      "label": "籍贯",
      "type": "text",
      "example": "广东省汕头市"
    },
    "basic.birthPlace": {
      "label": "出生地",
      "type": "text"
    },
    "basic.householdRegister": {
      "label": "户口所在地",
      "type": "text"
    },
    "basic.photo": {
